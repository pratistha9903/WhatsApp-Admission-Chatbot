    {
      "parameters": {
        "jsCode": "const incoming = $('Prepare Incoming Student Data').first().json;\n\nconst rows = $('Get row(s) in sheet').all()\n  .map(item => item.json)\n  .filter(row => row.Phone_Number);\n\nconst existing = rows[0] || {};\nconst merged = { ...existing };\n\nfor (const [key, value] of Object.entries(incoming)) {\n  if (\n    value !== undefined &&\n    value !== null &&\n    String(value).trim() !== ''\n  ) {\n    merged[key] = value;\n  }\n}\n\nmerged.Phone_Number = incoming.Phone_Number;\n\nreturn [{ json: merged }];"
      },
